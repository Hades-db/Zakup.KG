# Подключение к PostgreSQL под ролью zakup_server (см. db/schema.sql)
DATABASE_URL=postgres://zakup_server:CHANGE_ME@localhost:5432/zakup
# Секрет для подписи access-токенов: длинная случайная строка (openssl rand -base64 48)
JWT_SECRET=CHANGE_ME
# Срок жизни access-токена, секунд
ACCESS_TTL=900
PORT=3000
# В продакшене: production (строгая проверка секрета, запрет db:reset)
NODE_ENV=development
# Сайты, которым разрешено обращаться к API (через запятую). Пусто — любые (только для разработки)
CORS_ORIGINS=
